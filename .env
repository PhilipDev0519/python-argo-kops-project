# Application
APP_NAME=python-argo-app
APP_ENV=production
APP_PORT=5000
LOG_LEVEL=INFO

# Docker
IMAGE_NAME=python-argo
IMAGE_TAG=latest

# Kubernetes
K8S_NAMESPACE=python-app
K8S_CLUSTER_NAME=python.k8s.local

# AWS (Used by Kops / CLI / CI)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Optional (Future Enhancements)
ENABLE_METRICS=true
ENABLE_TRACING=false
